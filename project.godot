3d_render/layer_11="own_head_p1"
3d_render/layer_12="own_head_p2"
3d_render/layer_13="own_head_p3"
3d_render/layer_14="own_head_p4"
3d_physics/layer_1="world_static"
3d_physics/layer_2="world_dynamic"
3d_physics/layer_3="character"
3d_physics/layer_4="hitbox"
3d_physics/layer_5="ragdoll"
3d_physics/layer_6="held_prop"
3d_physics/layer_7="interactable"
3d_physics/layer_8="climbable"
3d_physics/layer_9="ladder"
3d_physics/layer_10="no_traverse"
3d_physics/layer_11="water"

[physics]

